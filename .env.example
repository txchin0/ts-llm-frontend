# URL of the ts-llm Fastify agent server that requests are proxied to.
# Defaults to http://127.0.0.1:3000 when unset.
# For mobile/LAN testing, point this at the machine running ts-llm, e.g.
#   VITE_TS_LLM_TARGET=http://192.168.1.10:3000
VITE_TS_LLM_TARGET=http://127.0.0.1:3000

# Set to 'true' for the Capacitor/native build to disable the PWA service worker
# (a service worker is pointless inside the native WebView). The `build:native`
# npm script sets this automatically; you normally don't set it by hand.
# VITE_NATIVE_BUILD=true
