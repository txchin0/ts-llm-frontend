{
  "name": "ts-llm-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Ember: a streaming chat client for the pi-llm agent server, shipped as a PWA and a Capacitor Android app with a native voice-assistant overlay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txchin0/ts-llm-frontend.git"
  },
  "keywords": ["llm", "chat", "react", "capacitor", "android", "pwa", "sse"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "cross-env VITE_NATIVE_BUILD=true npm run build",
    "cap:sync": "npm run build:native && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run cap:sync && cap run android",
    "preview": "vite preview",
    "serve": "node proxy.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "compress:icons": "node scripts/compress-public-pngs.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-speech-recognition": "^8.1.9",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
