    "",
    "data: {\"type\":\"tool_result\",\"request_id\":\"req_fixture01\",\"session_id\":\"sess_fixture01\",\"step\":0,\"tool_call_id\":\"call_fixture01\",\"tool_name\":\"google_calendar\",\"output\":{\"events\":[{\"title\":\"Design review\",\"start\":\"14:00\"}]},\"is_error\":false}",
    "",
    "data: {\"type\":\"delta\",\"text\":\"You have one meeting today: Design review at 14:00.\"}",
