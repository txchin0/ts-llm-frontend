{
  "$comment": "Canonical contract for the ts-llm Respond wire protocol. Single source for every client spelling: src/api/* (TypeScript, checked by src/api/respondProtocol.test.ts), the native assistant (Kotlin, checked by android/app/src/test/.../RespondProtocolTest.kt), and mock-server.mjs (which serves these samples). Change the protocol here first; the tests on each side fail until that side catches up.",
  "endpoints": {
    "respond": "/v1/respond",
    "authRegister": "/v1/auth/register",
    "authLogin": "/v1/auth/login",
    "authRefresh": "/v1/auth/refresh",
    "authLogout": "/v1/auth/logout",
    "tasks": "/v1/tasks",
    "integrations": "/v1/integrations",
    "oauthConnectToken": "/v1/oauth/connect-token",
    "oauthStatus": "/v1/oauth/{provider_id}/status",
    "oauthStart": "/v1/oauth/{provider_id}/start",
    "oauthDisconnect": "/v1/oauth/{provider_id}"
  },
  "oauthProviderSample": "google",
  "respondAccept": "text/event-stream",
  "request": {
    "message": "What's on my calendar today?",
    "session_id": "sess_fixture01",
    "show_thinking": true
  },
  "authRefreshRequest": {
    "refresh_token": "rt_fixture_1"
  },
  "authTokensResponse": {
    "user_id": "user_fixture",
    "token_type": "Bearer",
    "access_token": "at_fixture_2",
    "expires_in": 900,
    "refresh_token": "rt_fixture_2"
  },
  "events": {
    "start": {
      "type": "start",
      "request_id": "req_fixture01",
      "user_id": "user_fixture",
      "session_id": "sess_fixture01",
      "started_at": "2026-07-10T12:00:00.000Z"
    },
    "delta": {
      "type": "delta",
      "text": "You have one meeting today: Design review at 14:00."
    },
    "thinking_delta": {
      "type": "thinking_delta",
      "text": "The user wants today's events; I should call the calendar tool."
    },
    "final": {
      "type": "final",
      "request_id": "req_fixture01",
      "finish_reason": "stop",
      "completed_at": "2026-07-10T12:00:04.000Z"
    },
    "usage": {
      "type": "usage",
      "request_id": "req_fixture01",
      "usage": { "input_tokens": 142, "output_tokens": 96, "total_tokens": 238 }
    },
    "tool_call": {
      "type": "tool_call",
      "request_id": "req_fixture01",
      "session_id": "sess_fixture01",
      "step": 0,
      "tool_call_id": "call_fixture01",
      "tool_name": "google_calendar",
      "input": { "range": "today" }
    },
    "tool_result": {
      "type": "tool_result",
      "request_id": "req_fixture01",
      "session_id": "sess_fixture01",
      "step": 0,
      "tool_call_id": "call_fixture01",
      "tool_name": "google_calendar",
      "output": { "events": [{ "title": "Design review", "start": "14:00" }] },
      "is_error": false
    },
    "error": {
      "type": "error",
      "request_id": "req_fixture01",
      "code": "provider_error",
      "message": "The provider returned an error."
    }
  },
  "$streamComment": "One canonical turn: `stream` names the events in order; `rawStreamLines` is the same turn in wire form (physical lines, joined with \\n). It exercises the frame grammar both parsers must accept: an `event:` name line, a keep-alive comment, and one payload split across two data: lines. Parsing rawStreamLines must yield exactly the samples named in `stream` — tests on both sides verify that correspondence.",
  "stream": [
    "start",
    "thinking_delta",
    "tool_call",
    "tool_result",
    "delta",
    "usage",
    "final"
  ],
  "rawStreamLines": [
    "event: start",
